# Copy to .env and fill in only the sources you use. Every key is optional.
# The .env file holds secrets - it is git-ignored. Never commit it.

# ---------------------------------------------------------------- general
TIMEZONE=Europe/London
# DATA_DIR=./data                     # where DuckDB, inbox/ and processed/ live
DEFAULT_LOOKBACK_DAYS=30
LOG_LEVEL=INFO

# ---------------------------------------------------------------- WHOOP (https://developer-dashboard.whoop.com)
WHOOP_CLIENT_ID=
WHOOP_CLIENT_SECRET=
WHOOP_REDIRECT_URI=http://localhost:8501/connections

# ---------------------------------------------------------------- Renpho
# RENPHO_SOURCE=auto                  # auto | api | health_connect
RENPHO_EMAIL=
RENPHO_PASSWORD=

# ---------------------------------------------------------------- MyFitnessPal
# MFP_SOURCE=auto                     # auto | export | health_connect | scraper
# MFP_EXPORT_DIR=./data/inbox/myfitnesspal
MFP_WATER_UNIT=ml                     # ml | cups | fl_oz (scraper only)

# ---------------------------------------------------------------- Monzo via Google Sheets
GOOGLE_SERVICE_ACCOUNT_FILE=./secrets/google-service-account.json
MONZO_SHEET_ID=
# MONZO_WORKSHEET_NAME=               # default: first tab
# MONZO_CATEGORY_MAP={"eating out": "eating_out", "groceries": "groceries"}
# MONZO_EXCLUDED_CATEGORIES=["transfers", "savings", "income"]

# ---------------------------------------------------------------- Weather (Open-Meteo, no key)
WEATHER_LATITUDE=51.5072
WEATHER_LONGITUDE=-0.1276

# ---------------------------------------------------------------- Samsung S24 / Health Connect exports
# ANDROID_EXPORT_DIR=./data/inbox/android   # or a synced Google Drive / Syncthing folder

# ---------------------------------------------------------------- ActivityWatch
ACTIVITYWATCH_URL=http://localhost:5600
# AW_CODING_APP_PATTERNS=["code", "pycharm", "terminal"]
# AW_WORK_APP_PATTERNS=["outlook", "teams", "slack"]

# ---------------------------------------------------------------- Insight synthesis
LLM_PROVIDER=ollama                   # ollama | anthropic | none
OLLAMA_HOST=http://localhost:11434
OLLAMA_MODEL=llama3.1:8b

ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=high                 # low | medium | high | xhigh | max
ANTHROPIC_ENABLE_FALLBACKS=true       # server-side refusal fallback (Claude API)
